# Put the values you need into IntelliJ (Run > Edit Configurations > Environment variables)
# or into the Render dashboard. Do NOT commit real keys or passwords.

# ---- Local SQL Server (only if different from the defaults) ----
DB_PASSWORD=12345

# ---- AI keys (optional: you can also add them on the Settings page) ----
# GEMINI_API_KEY=...      free key: https://aistudio.google.com/apikey
# OPENAI_API_KEY=...      https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=...   https://console.anthropic.com/settings/keys
# GROQ_API_KEY=...        free key: https://console.groq.com/keys

# ---- Render + Neon (production) ----
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your-neon-password
# APP_PASSWORD=a-password-for-your-group
# APP_SECRET_KEY=a-long-random-string-used-to-encrypt-api-keys
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
