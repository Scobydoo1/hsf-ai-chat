<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root of the repository, only so IntelliJ can open the whole folder: File > Open > this folder imports the
  Maven project (backend/) and shows frontend/ and docs/ next to it. The real build is backend/pom.xml.
  Render (root directory "backend") and Vercel (root directory "frontend") do not use this file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hsf</groupId>
    <artifactId>ai-chat-root</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>ai-chat-root</name>

    <modules>
        <module>backend</module>
    </modules>
</project>
